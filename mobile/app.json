{
  "expo": {
    "name": "Team Asha Randonneuring",
    "slug": "team-asha-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "teamasha",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.teamasha.randonneuring",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "Team Asha uses your location to show you on the club's live ride map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Team Asha keeps sharing your location during a ride — even with the screen off — so the club can follow along. You control when sharing starts and stops."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Team Asha keeps sharing your location during a ride — even with the screen off — so the club can follow along.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.465825889971-bbk5vdfldcblrr6h91jvjd66tmgudf5h"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "apiBase": "https://team-asha-randonneuring.vercel.app",
      "googleIosClientId": "465825889971-bbk5vdfldcblrr6h91jvjd66tmgudf5h.apps.googleusercontent.com",
      "googleWebClientId": "465825889971-tkfv9td375ap2cle1pipm0sniogi0rjc.apps.googleusercontent.com",
      "eas": {
        "projectId": "a2d7adfa-7b86-4383-b5b7-cb2b7daaddfa"
      }
    },
    "owner": "mihirsam",
    "updates": {
      "url": "https://u.expo.dev/a2d7adfa-7b86-4383-b5b7-cb2b7daaddfa"
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
