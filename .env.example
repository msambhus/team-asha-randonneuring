# Supabase PostgreSQL connection string (required)
# Get this from the Supabase dashboard: Project Settings > Database > Connection string > URI
# Use the Transaction pooler (port 6543) for Vercel compatibility
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# Flask session secret (optional, has default)
SECRET_KEY=dev-key-change-in-prod

# Admin panel password (optional, has default)
ADMIN_PASSWORD=asha2026

# OpenAI API key for AI coaching advice (optional — falls back to rule-based advice)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Braintrust API key for observability and evals (optional — chat works without it)
# Get from: https://www.braintrust.dev/app/Team%20Asha/settings
BRAINTRUST_API_KEY=

# Linear API key (optional — needed for Claude Code to update Linear tickets directly)
# Get from: https://linear.app/settings/api — create a Personal API Key
LINEAR_API_KEY=lin_api_your_key_here

# Cron job authentication token (optional, only needed for automated Strava syncs)
# Generate with: openssl rand -hex 32
# Must match the CRON_SECRET in GitHub repository secrets
CRON_SECRET=your-random-secret-token-here

# Resend API key for sending passwordless email OTP login codes (mobile app).
# Without it, OTP codes are NOT emailed (the request returns 502). Get from:
# https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# From-address for OTP emails. Any local-part works on a Resend-verified domain
# (thrrive.fit is already verified). Swap to a Team Asha domain once verified.
OTP_FROM_EMAIL=Team Asha Randonneuring <teamasha@thrrive.fit>
# Public base URL used to build magic-link sign-in URLs in OTP emails.
APP_BASE_URL=https://team-asha-randonneuring.vercel.app
