{
  "name": "team-asha-randonneuring",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "npx tailwindcss -i ./static/input.css -o ./static/output.css --minify && npm run copy:brevethub-css",
    "copy:brevethub-css": "node -e \"const fs=require('fs');for(const f of ['output.css','style.css'])fs.copyFileSync('static/'+f,'brevethub/static/'+f);\"",
    "watch:css": "npm run build:css && npx tailwindcss -i ./static/input.css -o ./static/output.css --watch",
    "dev": "npm run watch:css",
    "vendor:pretext": "curl -sL 'https://cdn.jsdelivr.net/npm/@chenglou/pretext/+esm' -o static/js/pretext-esm-raw.js && echo 'Downloaded. Run the IIFE wrapper script to finalize.'",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "tailwindcss": "^3.4.1"
  }
}
