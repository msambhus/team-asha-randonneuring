# BrevetHub environment — copy to brevethub/.env and fill in. NEVER commit .env.

# Same Supabase Postgres as Team Asha (BrevetHub only ever touches rp_* tables).
DATABASE_URL=postgresql://user:password@host:6543/postgres

# BrevetHub's own Flask session secret (generate a fresh 32+ char random value).
BREVETHUB_SECRET_KEY=change-me-to-a-long-random-value

# Reused from Team Asha's existing Google OAuth client (add BrevetHub's redirect
# URIs to that client — see README).
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# RideWithGPS API — required to generate real ride plans (club-admin route +
# /cron/warm-brevet-plans). Get both at ridewithgps.com → Account Settings →
# Developers tab. Unset → real-plan generation fails soft; the guest /plan page
# still works (it reads only persisted plans, never calls RWGPS live).
RWGPS_API_KEY=your-rwgps-api-key
RWGPS_AUTH_TOKEN=your-rwgps-auth-token

# Local dev only: serves on http://localhost:5001
PORT=5001

# Per-deployment club identity (one BrevetHub instance = one club).
# When set, / becomes the club-branded home page instead of the generic landing.
BREVETHUB_CLUB_ID=3
BREVETHUB_REGION_PREFIX=CA: San Francisco
# Optional overrides:
# BREVETHUB_CLUB_ABBREV=SFR
# BREVETHUB_HERO_HEADLINE=Long rides out of San Francisco, all year.
# BREVETHUB_NEW_RIDER_GUIDE_URL=https://www.sfrandonneurs.org/new-riders
