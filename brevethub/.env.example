# BrevetHub environment — copy to brevethub/.env and fill in. NEVER commit .env.

# Same Supabase Postgres as Team Asha (BrevetHub only ever touches rp_* tables).
DATABASE_URL=postgresql://user:password@host:6543/postgres

# BrevetHub's own Flask session secret (generate a fresh 32+ char random value).
BREVETHUB_SECRET_KEY=change-me-to-a-long-random-value

# Reused from Team Asha's existing Google OAuth client (add BrevetHub's redirect
# URIs to that client — see README).
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Local dev only: serves on http://localhost:5001
PORT=5001
