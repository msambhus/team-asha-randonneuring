{
  "version": 2,
  "buildCommand": "cd .. && npm ci && npm run build:css",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "templates/**",
          "static/**",
          "../app.py",
          "../auth.py",
          "../cache.py",
          "../config.py",
          "../db.py",
          "../models.py",
          "../redirects.py",
          "../routes/**",
          "../services/**",
          "../shared/**",
          "../templates/**",
          "../static/**"
        ]
      }
    },
    { "src": "static/**", "use": "@vercel/static" }
  ],
  "crons": [
    { "path": "/api/cron/auto-generate-plans", "schedule": "30 7 * * *" },
    { "path": "/api/cron/backfill-wind", "schedule": "0 8 * * *" },
    { "path": "/api/cron/fetch-route-weather", "schedule": "30 8 * * *" },
    { "path": "/api/cron/warm-plan-elevation", "schedule": "0 9 * * *" }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ]
}
