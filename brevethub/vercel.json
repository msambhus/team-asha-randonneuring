{
  "version": 2,
  "buildCommand": "cd .. && npm ci && npm run build:css",
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python", "config": { "includeFiles": "shared/**" } },
    { "src": "static/**", "use": "@vercel/static" }
  ],
  "crons": [
    { "path": "/cron/refresh-calendar", "schedule": "0 8 * * *" },
    { "path": "/cron/fetch-brevet-weather", "schedule": "30 8 * * *" },
    { "path": "/cron/warm-brevet-plans", "schedule": "0 9 * * *" },
    { "path": "/cron/warm-brevet-route-weather", "schedule": "30 9 * * *" },
    { "path": "/cron/poll-garmin-livetrack", "schedule": "0 10 * * *" },
    { "path": "/cron/finalize-signups", "schedule": "0 11 * * *" },
    { "path": "/cron/sync-rusa-results", "schedule": "30 11 * * *" },
    { "path": "/cron/refresh-eddington", "schedule": "0 12 * * *" }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ]
}
